<Window x:Class="Felix.WindowSetup.Views.IntegrityCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_Integrity_Title}"
        Width="640"
        Height="370"
        MinWidth="540"
        MinHeight="320"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Integrity_File}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="FileValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Integrity_Size}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="SizeValue" Grid.Column="1" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Integrity_Sha256}" Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="Sha256Box" Grid.Column="1" IsReadOnly="True" Height="34" Margin="0,0,8,0"/>
                    <Button x:Name="CopyHashButton" Grid.Column="2" Content="{DynamicResource WS_Copy}"
                            Style="{StaticResource Redesign.Button}" MinHeight="34" Height="34" Padding="12,0"
                            IsEnabled="False" Click="CopyHash_Click"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Integrity_Sidecar}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="SidecarValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Integrity_Signature}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="SignatureValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <ProgressBar x:Name="HashProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Height="6"
                     Style="{StaticResource Redesign.ProgressBar}" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseIntegrityButton" Content="{DynamicResource WS_Close}"
                    Style="{StaticResource Redesign.PrimaryButton}" MinHeight="34" Padding="16,6"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
