<Application x:Class="Felix.WindowSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Felix.UI;component/Themes/Colors/Fallback.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Felix.UI;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Felix.UI;component/Resources/Icons/Fluent/FluentIcons.xaml"/>
                <ResourceDictionary Source="Resources/Lang/en/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
