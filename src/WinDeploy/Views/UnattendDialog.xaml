<Window x:Class="Felix.WindowSetup.Views.UnattendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WS_Unattend_Title}"
        Width="740"
        Height="560"
        MinWidth="600"
        MinHeight="460"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WS_Unattend_Username}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
            <TextBox x:Name="UsernameBox" Grid.Row="0" Grid.Column="1" Text="Admin" Height="34" Margin="0,0,12,8"
                     TextChanged="Field_Changed"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource WS_Unattend_ComputerName}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
            <TextBox x:Name="ComputerNameBox" Grid.Row="0" Grid.Column="3" Text="*" Height="34" Margin="0,0,0,8"
                     TextChanged="Field_Changed"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource WS_Unattend_Password}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PasswordBox" Height="34" Margin="0,0,6,0" TextChanged="Field_Changed"/>
                <Button Grid.Column="1" Content="{DynamicResource WS_Unattend_Generate}" Style="{StaticResource Redesign.Button}"
                        MinHeight="34" Padding="10,4" Click="GeneratePassword_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource WS_Unattend_TimeZone}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
            <TextBox x:Name="TimeZoneBox" Grid.Row="1" Grid.Column="3" Height="34" Margin="0,0,0,8"
                     TextChanged="Field_Changed"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WS_Unattend_Locale}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
            <TextBox x:Name="LocaleBox" Grid.Row="2" Grid.Column="1" Text="en-US" Height="34" Margin="0,0,12,0"
                     TextChanged="Field_Changed"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="SkipOobeCheck" Content="{DynamicResource WS_Unattend_SkipOobe}" IsChecked="True" Margin="0,0,16,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="AutoLogonCheck" Content="{DynamicResource WS_Unattend_AutoLogon}" IsChecked="True" Margin="0,0,16,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="ClearPasswordCheck" Content="{DynamicResource WS_Unattend_ClearPassword}" IsChecked="False" Margin="0,0,16,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="BypassMsAccountCheck" Content="{DynamicResource WS_Option_BypassMsAccount}" IsChecked="True" Margin="0,0,0,4"
                      Checked="Check_Changed" Unchecked="Check_Changed"/>
        </WrapPanel>

        <TextBox x:Name="PreviewBox" Grid.Row="2" FontFamily="Consolas" FontSize="12"
                 AcceptsReturn="True" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Padding="10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource WS_Cancel}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource WS_Unattend_SaveAs}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="SaveAs_Click"/>
            <Button x:Name="UseButton" Content="{DynamicResource WS_Use}" Style="{StaticResource Redesign.PrimaryButton}"
                    MinHeight="34" Padding="18,6" Click="Use_Click"/>
        </StackPanel>
    </Grid>
</Window>
