<fw:FeatureWindow x:Class="Felix.WindowSetup.Views.ResumeBackupWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:fw="clr-namespace:Felix.UI.Controls;assembly=Felix.UI"
                  Title="{DynamicResource WS_Resume_Title}"
                  Width="780"
                  Height="540"
                  MinWidth="660"
                  MinHeight="460"
                  FontSize="13.5"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="FontDecreaseButton" Content="A-" Style="{StaticResource Redesign.Button}"
                                MinHeight="30" Height="30" Padding="10,0" Margin="0,0,6,0" Click="FontDecrease_Click"/>
                        <Button x:Name="FontIncreaseButton" Content="A+" Style="{StaticResource Redesign.Button}"
                                MinHeight="30" Height="30" Padding="10,0" Click="FontIncrease_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="HeadingText" Text="{DynamicResource WS_ResumeBackup_Heading}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Resume_Source}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="SourceSummaryText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Resume_Target}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="TargetSummaryText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Redesign.Card}" Padding="14" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="SemiBold" Text="0%"/>
                    <TextBlock x:Name="StageText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar x:Name="BackupProgressBar" Minimum="0" Maximum="100" Height="10" Style="{StaticResource Redesign.ProgressBar}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Redesign.Card}" Padding="10" Margin="0,10,0,0">
            <TextBox x:Name="LogConsoleBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     FontFamily="Consolas, Cascadia Mono, Segoe UI"
                     FontSize="12.5"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>

        <Border x:Name="AlertBanner" Grid.Row="3"
                Background="{DynamicResource DangerSoft}"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="AlertText" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RestoreSafetyNowButton" Content="{DynamicResource WS_ResumeBackup_RestoreNow}" Style="{StaticResource Redesign.PrimaryButton}"
                    MinHeight="34" Margin="0,0,8,0" Visibility="Collapsed" Click="RestoreSafetyNow_Click"/>
            <Button x:Name="SkipSafetyRestoreButton" Content="{DynamicResource WS_ResumeBackup_DoNotRestore}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Margin="0,0,8,0" Visibility="Collapsed" Click="SkipSafetyRestore_Click"/>
            <Button x:Name="OpenCmdButton" Content="{DynamicResource WS_Resume_OpenCmd}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Margin="0,0,8,0" Click="OpenCmd_Click"/>
            <Button x:Name="RestartButton" Content="{DynamicResource WS_Resume_Restart}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Margin="0,0,8,0" IsEnabled="False" Click="Restart_Click"/>
            <Button x:Name="ShutdownButton" Content="{DynamicResource WS_Resume_Shutdown}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" IsEnabled="False" Click="Shutdown_Click"/>
        </StackPanel>
    </Grid>
</fw:FeatureWindow>
