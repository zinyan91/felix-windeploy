<Window x:Class="Felix.WindowSetup.Views.HandoffReadyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WS_Handoff_Title}"
        Width="560"
        Height="330"
        MinWidth="480"
        MinHeight="280"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16,12">
            <StackPanel>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Handoff_Staging}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                        <TextBlock x:Name="StagingValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Review_Windows}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                        <TextBlock x:Name="EditionValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Review_Disk}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                        <TextBlock x:Name="TargetValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Border Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Review_Source}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                        <TextBlock x:Name="SourceValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,16,0,0">
            <Button x:Name="CancelPreparationButton"
                    DockPanel.Dock="Left"
                    Content="{DynamicResource WS_Handoff_Cancel}"
                    Style="{StaticResource Redesign.DangerButton}"
                    MinHeight="36"
                    Padding="14,6"
                    Click="CancelPreparation_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextRestartButton"
                        Content="{DynamicResource WS_Handoff_NextRestart}"
                        Style="{StaticResource Redesign.Button}"
                        MinHeight="36"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Click="NextRestart_Click"/>
                <Button x:Name="RestartNowButton"
                        Content="{DynamicResource WS_Handoff_RestartNow}"
                        Style="{StaticResource Redesign.PrimaryButton}"
                        MinHeight="36"
                        Padding="18,6"
                        Click="RestartNow_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
