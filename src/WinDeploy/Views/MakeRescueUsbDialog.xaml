<Window x:Class="Felix.WindowSetup.Views.MakeRescueUsbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_RescueUsb_Title}"
        Width="540"
        Height="340"
        MinWidth="460"
        MinHeight="300"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16">
            <StackPanel>
                <TextBlock x:Name="UsbSummaryText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="KeepDataText" Text="{DynamicResource WS_RescueUsb_KeepData}" Foreground="{DynamicResource Success}" FontWeight="Medium" TextWrapping="Wrap"/>
                <Border x:Name="EraseWarningBanner" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource WS_RescueUsb_EraseWarn}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel x:Name="ConfirmPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ConfirmPromptText" Margin="0,0,0,6"/>
            <TextBox x:Name="ConfirmBox" Height="34" TextChanged="ConfirmBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center">
            <ProgressBar x:Name="WorkProgressBar" IsIndeterminate="True" Height="6" Style="{StaticResource Redesign.ProgressBar}" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource OnSurfaceMuted}" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseUsbButton" Content="{DynamicResource WS_Close}" Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="CreateUsbButton" Content="{DynamicResource WS_RescueUsb_Create}" Style="{StaticResource Redesign.PrimaryButton}" MinHeight="34" Padding="16,6" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
