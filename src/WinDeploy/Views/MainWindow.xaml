<fw:FeatureWindow x:Class="Felix.WindowSetup.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:fw="clr-namespace:Felix.UI.Controls;assembly=Felix.UI"
                  xmlns:core="clr-namespace:Felix.WindowSetup.Core;assembly=Felix.WinDeploy.Core"
                  xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
                  Title="{DynamicResource WS_Title}"
                  Width="1160"
                  Height="820"
                  MinWidth="980"
                  MinHeight="680"
                  FontSize="13.5"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolConverter x:Key="InvBool"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <helpers:NullToVisibilityConverter x:Key="NullVis"/>
        <helpers:BytesToTextConverter x:Key="BytesText"/>

        <Style x:Key="TopTabButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TabBg"
                                    CornerRadius="6,6,0,0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveBar"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Primary}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource NavItemHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleTileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryOutline}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Primary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{DynamicResource WS_Badge_Off}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Text" Value="{DynamicResource WS_Badge_On}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WrapRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiskCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PartitionCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsUnallocated}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Surface3}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBitLocker}" Value="True">
                                <Setter Property="Opacity" Value="0.62"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <fw:FeatureWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="LanguageButton"
                    Content="{DynamicResource WS_LanguageToggle}"
                    Style="{StaticResource Redesign.TextButton}"
                    Margin="0,0,6,0"
                    Click="ToggleLanguage_Click"/>
            <Button x:Name="ThemeButton"
                    Style="{StaticResource Redesign.TextButton}"
                    Click="ToggleTheme_Click">
                <TextBlock x:Name="ThemeButtonText" Text="{DynamicResource WS_ThemeDark}"/>
            </Button>
        </StackPanel>
    </fw:FeatureWindow.HeaderRightContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP UNDERLINE TAB BAR -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}"
                           VerticalAlignment="Center" Margin="12,0,4,0">
                    <Run Text="{Binding EnvironmentLabel, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding CurrentArchitectureLabel, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Target.BootFirmwareLabel, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NavInstallButton"
                            Style="{StaticResource TopTabButtonStyle}"
                            Tag="{Binding IsInstallMainTab}"
                            Margin="0,0,4,0"
                            Click="NavInstall_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="{StaticResource Icon.Common.Desktop.Regular}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource WS_Nav_Install}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavBackupButton"
                            Style="{StaticResource TopTabButtonStyle}"
                            Tag="{Binding IsBackupMainTab}"
                            Margin="0,0,4,0"
                            Click="NavBackup_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="{StaticResource Icon.Sidebar.Save.Regular}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource WS_Nav_Backup}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavHardwareButton"
                            Style="{StaticResource TopTabButtonStyle}"
                            Tag="{Binding IsHardwareMainTab}"
                            Click="NavHardware_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="{StaticResource Icon.Common.FlashSparkle.Regular}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource WS_Nav_Hardware}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE (FULL WIDTH, 2 COLUMNS) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">

                <!-- INSTALL WINDOWS WORKBENCH (2-COLUMN STUDIO LAYOUT) -->
                <Grid x:Name="MainInstallSection"
                      Visibility="{Binding IsInstallMainTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.42*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: SOURCE + TARGET DISK & ROLES -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- WINDOWS IMAGE CARD -->
                            <Border x:Name="SourceSection" Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="FindSourceButton"
                                                    Content="{DynamicResource WS_FindSource}"
                                                    Style="{StaticResource Redesign.TextButton}"
                                                    Margin="0,0,4,0"
                                                    Click="FindSource_Click"/>
                                            <Button x:Name="DownloadSourceButton"
                                                    Content="{DynamicResource WS_Source_Download}"
                                                    Style="{StaticResource Redesign.TextButton}"
                                                    Margin="0,0,4,0"
                                                    Click="DownloadSource_Click"/>
                                            <Button x:Name="VerifyGenuineButton"
                                                    Content="{DynamicResource WS_Source_VerifyGenuine}"
                                                    Style="{StaticResource Redesign.TextButton}"
                                                    IsEnabled="{Binding Source.IsValid}"
                                                    Click="VerifyGenuine_Click"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource BorderStrong}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source.IsValid}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Source.HasError}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{DynamicResource WS_Source_CardTitle}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Image}" FontSize="12"
                                                   Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SourcePathBox" Grid.Column="1"
                                                 Text="{Binding Source.EditablePath, UpdateSourceTrigger=PropertyChanged}"
                                                 AllowDrop="True"
                                                 PreviewDragOver="SourcePathBox_PreviewDragOver"
                                                 Drop="SourcePathBox_Drop"
                                                 KeyDown="SourcePathBox_KeyDown"
                                                 LostFocus="SourcePathBox_LostFocus"
                                                 Height="31" Margin="0,0,6,0"/>
                                        <Button x:Name="ClipboardSourceButton" Grid.Column="2"
                                                Content="{DynamicResource WS_Clipboard}"
                                                Style="{StaticResource Redesign.Button}" MinHeight="31" Height="31" Padding="10,0" Margin="0,0,6,0"
                                                Click="PasteClipboardSource_Click"/>
                                        <Button x:Name="BrowseImageButton" Grid.Column="3"
                                                Content="{DynamicResource WS_Browse}"
                                                Style="{StaticResource Redesign.Button}" MinHeight="31" Height="31" Padding="12,0"
                                                Click="BrowseImage_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource WS_Edition}" FontSize="12"
                                                   Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="EditionCombo" Grid.Column="1" Height="31" Margin="0,0,10,0"
                                                  ItemsSource="{Binding Source.Editions}"
                                                  SelectedItem="{Binding Source.Edition}"
                                                  DisplayMemberPath="DisplayName"/>
                                        <CheckBox x:Name="VerifyImageToggle" Grid.Column="2"
                                                  Content="{DynamicResource WS_Option_VerifyImage}"
                                                  IsChecked="{Binding VerifyImage}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,9,0,0"
                                            Visibility="{Binding Source.HasError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Source.Error}" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                                            Visibility="{Binding HasSourceCompatibilityError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SourceCompatibilityError}" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- TARGET DISK & PARTITIONS CARD -->
                            <Border x:Name="TargetSection" Grid.Row="1" Style="{StaticResource Redesign.Card}" Padding="12,9">
                                <DockPanel LastChildFill="True">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <Button x:Name="RefreshTargetsButton" DockPanel.Dock="Right" Content="{DynamicResource WS_Refresh}"
                                                Style="{StaticResource Redesign.TextButton}"
                                                Click="Refresh_Click"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource BorderStrong}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Target.IsValid}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{DynamicResource WS_Target_CardTitle}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Redesign.Segmented}"
                                                 SelectedValue="{Binding Target.EraseFirmware}" SelectedValuePath="Tag"
                                                 Visibility="{Binding Target.IsEraseMode, Converter={StaticResource BoolToVis}}">
                                            <ListBoxItem Tag="{x:Static core:FirmwareMode.UefiGpt}" Content="{DynamicResource WS_Firmware_UEFI}"/>
                                            <ListBoxItem Tag="{x:Static core:FirmwareMode.BiosMbr}" Content="{DynamicResource WS_Firmware_BIOS}"/>
                                        </ListBox>
                                        <ListBox x:Name="ModeSegmented"
                                                 Style="{StaticResource Redesign.Segmented}"
                                                 SelectedValue="{Binding Target.Mode}"
                                                 SelectedValuePath="Tag">
                                            <ListBoxItem Tag="{x:Static core:InstallTargetMode.ExistingPartition}"
                                                         Content="{DynamicResource WS_Mode_Existing}"/>
                                            <ListBoxItem Tag="{x:Static core:InstallTargetMode.EraseDisk}"
                                                         Content="{DynamicResource WS_Mode_Erase}"/>
                                        </ListBox>
                                    </DockPanel>

                                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,6,0,0"
                                            Visibility="{Binding Target.EraseWarningText, Converter={StaticResource StrVis}}">
                                        <TextBlock Text="{Binding Target.EraseWarningText}" Foreground="{DynamicResource Danger}"
                                                   FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- 3 Role ComboBoxes docked at bottom inside TargetSection -->
                                    <Border x:Name="TargetSummaryBox" DockPanel.Dock="Bottom"
                                            Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,4,0,0"
                                            Visibility="{Binding Target.IsExistingMode, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{DynamicResource WS_RoleCombo_Windows}" FontSize="11.5" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="Medium"/>
                                                    <Ellipse Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                                                             Fill="{DynamicResource Success}"
                                                             Visibility="{Binding Target.SelectedWindowsOption, Converter={StaticResource NullVis}}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="WindowsRoleCombo" MinHeight="28" Height="28" FontSize="12"
                                                          ItemsSource="{Binding Target.WindowsRoleOptions}"
                                                          SelectedItem="{Binding Target.SelectedWindowsOption}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{DynamicResource WS_RoleCombo_System}" FontSize="11.5" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="Medium"/>
                                                    <Ellipse Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                                                             Fill="{DynamicResource Success}"
                                                             Visibility="{Binding Target.SelectedSystemOption, Converter={StaticResource NullVis}}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="SystemRoleCombo" MinHeight="28" Height="28" FontSize="12"
                                                          ItemsSource="{Binding Target.SystemRoleOptions}"
                                                          SelectedItem="{Binding Target.SelectedSystemOption}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{DynamicResource WS_RoleCombo_Recovery}" FontSize="11.5" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="Medium"/>
                                                    <Ellipse Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                                                             Fill="{DynamicResource Success}"
                                                             Visibility="{Binding Target.SelectedRecoveryOption, Converter={StaticResource NullVis}}"/>
                                                </StackPanel>
                                                <ComboBox x:Name="RecoveryRoleCombo" MinHeight="28" Height="28" FontSize="12"
                                                          ItemsSource="{Binding Target.RecoveryRoleOptions}"
                                                          SelectedItem="{Binding Target.SelectedRecoveryOption}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DiskMapList" ItemsSource="{Binding Target.Disks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="DiskRowBorder" Background="{DynamicResource Surface2}"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                        CornerRadius="10" Padding="5" Margin="0,0,0,4"
                                                        IsEnabled="{Binding IsEnabled}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.48"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEraseSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="138"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0" Style="{StaticResource DiskCardButtonStyle}"
                                                                Margin="0,0,7,0"
                                                                CommandParameter="{Binding}" Click="DiskCard_Click">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" FontSize="13"><Run Text="{DynamicResource WS_Disk_Prefix}"/><Run Text=" "/><Run Text="{Binding Facts.Number, Mode=OneWay}"/></TextBlock>
                                                                <TextBlock Text="{Binding Facts.Model}" Foreground="{DynamicResource OnSurfaceSecondary}"
                                                                           FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource OnSurfaceMuted}"
                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Facts.Bus, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding Facts.Style, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding Facts.Size, Mode=OneWay, Converter={StaticResource BytesText}}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding HasBlockReason, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding BlockReason}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Block}" Value="FelixPe"><Setter Property="Text" Value="{DynamicResource WS_Block_FelixPe}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="RunningWindows"><Setter Property="Text" Value="{DynamicResource WS_Block_RunningWindows}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="ReadOnly"><Setter Property="Text" Value="{DynamicResource WS_Block_ReadOnly}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="Offline"><Setter Property="Text" Value="{DynamicResource WS_Block_Offline}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="Dynamic"><Setter Property="Text" Value="{DynamicResource WS_Block_Dynamic}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="HoldsSetupFiles"><Setter Property="Text" Value="{DynamicResource WS_Block_HoldsSetupFiles}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Block}" Value="DesktopPhysicalDisk"><Setter Property="Text" Value="{DynamicResource WS_Block_DesktopPhysicalDisk}"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasPartitionBlockReason}" Value="True"/>
                                                                                        <Condition Binding="{Binding DataContext.Target.IsExistingMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                                <DataTrigger Binding="{Binding PartitionBlock}" Value="StyleMismatch"><Setter Property="Text" Value="{DynamicResource WS_PartitionBlock_StyleMismatch}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding PartitionBlock}" Value="NoSystemPartition"><Setter Property="Text" Value="{DynamicResource WS_PartitionBlock_NoSystemPartition}"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>

                                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                            <ScrollViewer.Style>
                                                                <Style TargetType="ScrollViewer">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasPlannedLayout}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ScrollViewer.Style>
                                                            <ItemsControl ItemsSource="{Binding Cards}"
                                                                          MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <fw:ProportionalSegmentPanel FillWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                                                     SegmentHeight="44" MinimumSegmentWidth="92"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="fw:ProportionalSegmentPanel.Weight" Value="{Binding Weight}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource PartitionCardButtonStyle}"
                                                                                CommandParameter="{Binding}" Click="PartitionCard_Click">
                                                                            <Button.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="{DynamicResource WS_Role_Windows}"
                                                                                              IsEnabled="{Binding CanAssignWindows}"
                                                                                              Click="ContextAssignWindows_Click"/>
                                                                                    <MenuItem Header="{DynamicResource WS_Role_System}"
                                                                                              IsEnabled="{Binding CanAssignSystem}"
                                                                                              Click="ContextAssignSystem_Click"/>
                                                                                    <MenuItem Header="{DynamicResource WS_Role_Recovery}"
                                                                                              IsEnabled="{Binding CanAssignRecovery}"
                                                                                              Click="ContextAssignRecovery_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{DynamicResource WS_BitLocker_Unlock}"
                                                                                              Visibility="{Binding CanUnlockBitLocker, Converter={StaticResource BoolToVis}}"
                                                                                              Click="ContextUnlockBitLocker_Click"/>
                                                                                    <MenuItem Header="{DynamicResource WS_BitLocker_TurnOff}"
                                                                                              Visibility="{Binding CanTurnOffBitLocker, Converter={StaticResource BoolToVis}}"
                                                                                              Click="ContextTurnOffBitLocker_Click"/>
                                                                                </ContextMenu>
                                                                            </Button.ContextMenu>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <DockPanel Grid.Row="0">
                                                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Primary}" CornerRadius="4"
                                                                                            Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                                            Visibility="{Binding HasRole, Converter={StaticResource BoolToVis}}">
                                                                                        <TextBlock Text="{Binding RoleBadge}" FontSize="9" FontWeight="SemiBold"
                                                                                                   TextWrapping="NoWrap" Foreground="{DynamicResource OnPrimary}"/>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                                                               TextWrapping="NoWrap" VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                </DockPanel>
                                                                                <TextBlock Grid.Row="1" FontSize="10.5" Foreground="{DynamicResource OnSurfaceMuted}"
                                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding FileSystemText, Mode=OneWay}"/>
                                                                                    <Run Text=" · "/>
                                                                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <ProgressBar Grid.Row="3" Minimum="0" Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}"
                                                                                             Height="4" Margin="0,4,0,0"
                                                                                             Visibility="{Binding IsUnallocated, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                                                            </Grid>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                      Visibility="{Binding HasPlannedLayout, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl ItemsSource="{Binding PlannedLayout}"
                                                                          MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <fw:ProportionalSegmentPanel FillWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                                                     SegmentHeight="44" MinimumSegmentWidth="92"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="fw:ProportionalSegmentPanel.Weight" Value="{Binding Weight}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                                                                                BorderThickness="1" CornerRadius="7" Margin="2,0" Padding="9,6">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Role, TargetNullValue=MSR}" FontSize="12" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,2,0,0">
                                                                                    <Run Text="{Binding PlannedFileSystem, Mode=OneWay}"/>
                                                                                    <Run Text=" · "/>
                                                                                    <Run Text="{Binding PlannedSize, Mode=OneWay, Converter={StaticResource BytesText}}"/>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- RIGHT COLUMN: DEPLOYMENT CONFIGURATION -->
                        <Border x:Name="OptionsSection" Grid.Column="2" Style="{StaticResource Redesign.Card}" Padding="14,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WS_Options_CardTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- 2x2 Flat Module Tiles -->
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Button x:Name="DriversButton"
                                            Style="{StaticResource ModuleTileButtonStyle}"
                                            Tag="{Binding IsDriverBackupActive}"
                                            Margin="0,0,6,6"
                                            Click="ConfigureDrivers_Click">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModuleBadgeBorderStyle}" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource ModuleBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource WS_Module_Drivers}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>

                                    <Button x:Name="BloatwareButton"
                                            Style="{StaticResource ModuleTileButtonStyle}"
                                            Tag="{Binding IsBloatwareActive}"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Margin="0,0,0,6"
                                            Click="ConfigureBloatware_Click">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModuleBadgeBorderStyle}" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource ModuleBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource WS_Module_Bloatware}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>

                                    <Button x:Name="RemoteAppsButton"
                                            Style="{StaticResource ModuleTileButtonStyle}"
                                            Tag="{Binding IsRemoteAppsActive}"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Margin="0,0,6,0"
                                            Click="ConfigureRemoteApps_Click">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModuleBadgeBorderStyle}" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource ModuleBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource WS_Module_Remote}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>

                                    <Button x:Name="RecordButton"
                                            Style="{StaticResource ModuleTileButtonStyle}"
                                            Tag="{Binding IsRecordingActive}"
                                            Click="ConfigureRecording_Click">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModuleBadgeBorderStyle}" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource ModuleBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource WS_Module_Record}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </UniformGrid>

                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,2,0,10"/>

                                <!-- Unattend.xml -->
                                <TextBlock Text="{DynamicResource WS_Unattend}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UnattendBox" Grid.Column="0" IsReadOnly="True" Height="30" FontSize="12.5" Margin="0,0,5,0"
                                             IsEnabled="{Binding IsInstallCustomizationAllowed}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Text" Value="{Binding AnswerPath, Mode=OneWay}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGeneratedUnattendActive}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource WS_Unattend_Generated}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button x:Name="CreateUnattendButton" Grid.Column="1" Content="{DynamicResource WS_Create}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="8,0" FontSize="12" Margin="0,0,5,0"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Click="CreateUnattend_Click"/>
                                    <Button x:Name="BrowseUnattendButton" Grid.Column="2" Content="{DynamicResource WS_Browse}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="8,0" FontSize="12" Margin="0,0,5,0"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Click="BrowseAnswerFile_Click"/>
                                    <Button x:Name="ClearUnattendButton" Grid.Column="3" Content="{DynamicResource WS_Unattend_Clear}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="8,0" FontSize="12"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Click="ClearUnattend_Click"/>
                                </Grid>

                                <!-- 2-Column Option Flags -->
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <CheckBox x:Name="BypassMsAccountCheck" Content="{DynamicResource WS_Option_BypassMsAccount}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding BypassMicrosoftAccount}"
                                              IsEnabled="{Binding IsInstallCustomizationAllowed}"/>
                                    <CheckBox x:Name="ClearBootMenuCheck" Content="{DynamicResource WS_Option_ClearBootMenu}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding ClearBootMenu}"/>
                                    <CheckBox x:Name="CreateNewRecoveryCheck" Content="{DynamicResource WS_Option_CreateRecovery}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding CreateNewRecovery}"
                                              IsEnabled="{Binding CanCreateNewRecovery}"/>
                                    <CheckBox x:Name="AddParallelWindowsCheck" Content="{DynamicResource WS_Option_ParallelWindows}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding AddParallelWindows}"/>
                                    <CheckBox x:Name="ExportWifiCheck" Content="{DynamicResource WS_Option_ExportWifi}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding ExportConnectedWifi}"/>
                                    <CheckBox x:Name="InstallSilentlyCheck" Content="{DynamicResource WS_Option_InstallSilently}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding InstallAppsSilently}"
                                              IsEnabled="{Binding IsInstallCustomizationAllowed}"/>
                                    <CheckBox x:Name="RestartCompleteCheck" Content="{DynamicResource WS_Option_RestartWhenComplete}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding RestartWhenComplete}"/>
                                    <CheckBox x:Name="DesktopReportCheck" Content="{DynamicResource WS_Option_DesktopReport}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding WriteDesktopSummaryReport}"/>
                                </UniformGrid>

                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,2,0,10"/>

                                <!-- Paths, FirstDesktop & Rescue USB -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Drivers_WindowsFolder}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="WindowsDriversBox" Grid.Column="1"
                                             Text="{Binding WindowsDriversFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" FontSize="12.5" Margin="0,0,5,0"/>
                                    <Button Grid.Column="2" Content="{DynamicResource WS_Browse}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="9,0" FontSize="12"
                                            Click="BrowseWindowsDrivers_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Drivers_WinPeFolder}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="WinPeDriversBox" Grid.Column="1"
                                             Text="{Binding WinPeDriversFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" FontSize="12.5" Margin="0,0,5,0"/>
                                    <Button Grid.Column="2" Content="{DynamicResource WS_Browse}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="9,0" FontSize="12"
                                            Click="BrowseWinPeDrivers_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_ExtraWinPe}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="ExtraWinPeBox" Grid.Column="1"
                                             Text="{Binding ExtraWinPePath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" FontSize="12.5" Margin="0,0,5,0"/>
                                    <Button x:Name="FindWinPeButton" Grid.Column="2" Content="{DynamicResource WS_FindWinPe}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="8,0" FontSize="12" Margin="0,0,5,0"
                                            Click="FindWinPe_Click"/>
                                    <Button Grid.Column="3" Content="{DynamicResource WS_Browse}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="9,0" FontSize="12"
                                            Click="BrowseExtraWinPe_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_FirstDesktop}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ComboBox x:Name="FirstDesktopModeCombo" Grid.Column="1"
                                              SelectedValue="{Binding FirstDesktopMode}" SelectedValuePath="Tag"
                                              IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                              Height="30" FontSize="12.5">
                                        <ComboBoxItem Tag="{x:Static core:FirstDesktopAppMode.None}" Content="{DynamicResource WS_FirstDesktop_None}"/>
                                        <ComboBoxItem Tag="{x:Static core:FirstDesktopAppMode.PortableExe}" Content="{DynamicResource WS_FirstDesktop_Portable}"/>
                                        <ComboBoxItem Tag="{x:Static core:FirstDesktopAppMode.ZipArchive}" Content="{DynamicResource WS_FirstDesktop_Zip}"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,7"
                                      Visibility="{Binding HasFirstDesktopSource, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FirstDesktopPathBox" Grid.Column="1"
                                             Text="{Binding FirstDesktopSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                             Height="30" FontSize="12.5" Margin="0,0,5,0"/>
                                    <Button x:Name="FirstDesktopBrowseButton" Grid.Column="2" Content="{DynamicResource WS_Browse}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="9,0" FontSize="12"
                                            IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                            Click="BrowseFirstDesktop_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,7"
                                      Visibility="{Binding IsFirstDesktopZipMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_FirstDesktop_ZipProgram}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ComboBox x:Name="ZipProgramCombo" Grid.Column="1"
                                              ItemsSource="{Binding ZipPrograms}"
                                              SelectedItem="{Binding FirstDesktopZipProgram}"
                                              IsEditable="True"
                                              IsEnabled="{Binding IsInstallCustomizationAllowed}"
                                              Text="{Binding FirstDesktopZipProgram, UpdateSourceTrigger=PropertyChanged}"
                                              Height="30" FontSize="12.5"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_RescueUsb}" FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ComboBox x:Name="RescueUsbCombo" Grid.Column="1" Height="30" FontSize="12.5" Margin="0,0,5,0"
                                              ItemsSource="{Binding RescueUsbOptions}"
                                              SelectedItem="{Binding SelectedRescueUsbOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding DisplayText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource WS_RescueUsb_None}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="MakeRescueUsbButton" Grid.Column="2" Content="{DynamicResource WS_RescueUsb_MakeBtn}"
                                            Style="{StaticResource Redesign.Button}" MinHeight="30" Height="30" Padding="9,0" FontSize="12"
                                            IsEnabled="{Binding CanMakeStandaloneRescueUsb}"
                                            Click="MakeRescueUsb_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BACKUP WINDOWS WORKBENCH (2-COLUMN STUDIO LAYOUT) -->
                    <Grid x:Name="BackupSection"
                          Visibility="{Binding IsBackupMainTab, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: SOURCE & ARCHIVE + PREFLIGHT -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Redesign.Card}" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource WS_Refresh}"
                                                Style="{StaticResource Redesign.TextButton}" Click="RefreshBackupSources_Click"/>
                                        <TextBlock Text="{DynamicResource WS_Backup_SourceCard}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="{DynamicResource WS_Backup_SourceWin}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="BackupSourceCombo" Height="34" Margin="0,0,0,10"
                                              ItemsSource="{Binding Backup.Sources}"
                                              SelectedItem="{Binding Backup.SelectedSource}"
                                              DisplayMemberPath="DisplayLabel"/>

                                    <TextBlock Text="{DynamicResource WS_Backup_Output}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BackupOutputBox" Grid.Column="0" Height="34" Margin="0,0,8,0"
                                                 Text="{Binding Backup.OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource WS_Browse}" Style="{StaticResource Redesign.Button}"
                                                MinHeight="34" Height="34" Padding="14,0" Click="BrowseBackupDestination_Click"/>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource WS_Backup_Format}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding Backup.IsSwmFormat, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{DynamicResource WS_Backup_SwmSplit}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="80" Height="30" Text="{Binding Backup.SplitPartSizeMiB, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="FormatWimRadio" Content=".WIM" GroupName="BackupFormatGroup"
                                                         IsChecked="{Binding Backup.IsWimFormat}" Margin="0,0,16,0"/>
                                            <RadioButton x:Name="FormatEsdRadio" Content=".ESD" GroupName="BackupFormatGroup"
                                                         IsChecked="{Binding Backup.IsEsdFormat}" Margin="0,0,16,0"/>
                                            <RadioButton x:Name="FormatSwmRadio" Content=".SWM" GroupName="BackupFormatGroup"
                                                         IsChecked="{Binding Backup.IsSwmFormat}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource WS_Backup_ImageName}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="BackupImageNameBox" Height="34"
                                                     Text="{Binding Backup.ImageName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource WS_Backup_Description}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                            <TextBox Height="34"
                                                     Text="{Binding Backup.ImageDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding Backup.PreflightErrorText, Converter={StaticResource StrVis}}">
                                <TextBlock Text="{Binding Backup.PreflightErrorText}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                    Visibility="{Binding Backup.PreflightWarningText, Converter={StaticResource StrVis}}">
                                <TextBlock Text="{Binding Backup.PreflightWarningText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Border Style="{StaticResource Redesign.Card}" Padding="14,10"
                                    Visibility="{Binding Backup.IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Backup.ProgressValue, StringFormat={}{0}%}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                                        <TextBlock Text="{Binding Backup.StatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Redesign.ProgressBar}" Minimum="0" Maximum="100" Value="{Binding Backup.ProgressValue, Mode=OneWay}" Height="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT: CAPTURE MODE + SYSPREP ROLLBACK -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Redesign.Card}" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource WS_Backup_MethodCard}" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <RadioButton x:Name="BackupMethodLiveRadio" GroupName="BackupMethodGroup"
                                                 Style="{StaticResource WrapRadioButtonStyle}"
                                                 Content="{DynamicResource WS_Backup_MethodLive}"
                                                 IsChecked="{Binding Backup.IsLiveOrOfflineMethod}"/>
                                    <RadioButton x:Name="BackupMethodWinPeRadio" GroupName="BackupMethodGroup"
                                                 Style="{StaticResource WrapRadioButtonStyle}"
                                                 Content="{DynamicResource WS_Backup_MethodWinPe}"
                                                 IsChecked="{Binding Backup.IsWinPeCaptureMethod}"/>
                                    <RadioButton x:Name="BackupMethodSysprepRadio" GroupName="BackupMethodGroup"
                                                 Style="{StaticResource WrapRadioButtonStyle}"
                                                 Content="{DynamicResource WS_Backup_MethodSysprep}"
                                                 IsEnabled="{Binding Backup.CanChooseSysprep}"
                                                 IsChecked="{Binding Backup.IsSysprepMethod}" Margin="0,0,0,12"/>

                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="BackupPortableCheck"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              Content="{DynamicResource WS_Backup_Portable}"
                                              IsEnabled="{Binding Backup.IsNonSysprepMethod}"
                                              IsChecked="{Binding Backup.MakePortableAcrossHardware}"/>
                                    <CheckBox x:Name="BackupShutdownCheck"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              Content="{DynamicResource WS_Backup_ShutdownAfter}"
                                              IsChecked="{Binding Backup.ShutdownAfterCapture}" Margin="0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SysprepOptionsCard" Style="{StaticResource Redesign.Card}" Padding="16,14"
                                    Visibility="{Binding Backup.IsSysprepMethod, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource WS_Backup_SysprepCard}" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepGeneralize}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding Backup.SysprepGeneralize}"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepAudit}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding Backup.SysprepAuditMode}"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepStripDrivers}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding Backup.StripThirdPartyDrivers}"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepStripStorage}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsEnabled="{Binding Backup.StripThirdPartyDrivers}"
                                              IsChecked="{Binding Backup.StripStorageDrivers}"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepRestoreSuccess}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding Backup.AutoRestoreSafetyOnSuccess}"/>
                                    <CheckBox Content="{DynamicResource WS_Backup_SysprepRestoreFail}"
                                              Style="{StaticResource WrapCheckBoxStyle}"
                                              IsChecked="{Binding Backup.AutoRestoreSafetyOnFailure}" Margin="0,0,0,10"/>

                                    <TextBlock Text="{DynamicResource WS_Backup_SysprepUnattend}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="32" Margin="0,0,8,0"
                                                 Text="{Binding Backup.SysprepUnattendPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource WS_Browse}" Style="{StaticResource Redesign.Button}"
                                                MinHeight="32" Height="32" Padding="12,0" Click="BrowseSysprepUnattend_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- HARDWARE & WINDOWS RECOMMENDATION SECTION (FELIX-DESKTOP SYSTEMINFO STYLE) -->
                    <StackPanel x:Name="HardwareSection"
                                Visibility="{Binding IsHardwareMainTab, Converter={StaticResource BoolToVis}}">
                        <!-- 4-COLUMN HARDWARE SPEC STRIP -->
                        <Border Style="{StaticResource Redesign.Card}" Padding="0" Margin="0,0,0,12">
                            <UniformGrid Columns="4">
                                <Border Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Hardware.CpuDetail}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="16,14" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Hardware.RamTotal}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hardware.RamDetail}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="16,14" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Hardware.GpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Hardware.GpuDetail}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="16,14" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource WS_Hw_BoardFirmware}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Hardware.BoardName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Hardware.FirmwareDetail}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- 2-COLUMN ASSESSMENT & EDITION RECOMMENDATIONS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: RECOMMENDED WINDOWS EDITIONS -->
                            <Border Grid.Column="0" Style="{StaticResource Redesign.Card}" Padding="16,14">
                                <StackPanel>
                                    <Border Background="{DynamicResource PrimarySoft}" BorderBrush="{DynamicResource PrimaryOutline}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,12">
                                        <DockPanel>
                                            <Button x:Name="DownloadRecommendedButton" DockPanel.Dock="Right"
                                                    Content="{DynamicResource WS_Download_OpenFelix}"
                                                    Style="{StaticResource Redesign.PrimaryButton}"
                                                    MinHeight="34" Height="34" Padding="14,0" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="DownloadSource_Click"/>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource WS_Hw_RecommendedTitle}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                                                <TextBlock x:Name="HardwarePrimaryEditionText" Text="{Binding Hardware.PrimaryEdition}"
                                                           FontSize="17" FontWeight="SemiBold" Margin="0,2,0,3" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Hardware.PrimaryReason}" FontSize="12.5"
                                                           Foreground="{DynamicResource OnSurfaceSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{DynamicResource WS_Hw_EditionsTitle}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <ItemsControl x:Name="HardwareOptionsList" ItemsSource="{Binding Hardware.Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" CornerRadius="5" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Surface3}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.BestMatch}">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.CompatibleWithBypass}">
                                                                            <Setter Property="Background" Value="{DynamicResource WarningSoft}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.NotSupported}">
                                                                            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceSecondary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.BestMatch}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.CompatibleWithBypass}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:EditionRecommendationTier.NotSupported}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding EditionName}" FontSize="13.5" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" · " Foreground="{DynamicResource OnSurfaceMuted}"/>
                                                                <TextBlock Text="{Binding TargetUse}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ReasonText}" FontSize="12.5" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: HARDWARE COMPATIBILITY CHECKS -->
                            <Border Grid.Column="2" Style="{StaticResource Redesign.Card}" Padding="16,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="RefreshHardwareButton" DockPanel.Dock="Right"
                                                Content="{DynamicResource WS_Refresh}"
                                                Style="{StaticResource Redesign.TextButton}"
                                                Click="RefreshHardware_Click"/>
                                        <TextBlock Text="{DynamicResource WS_Hw_ChecksTitle}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="{DynamicResource WS_Hw_Loading}" Foreground="{DynamicResource OnSurfaceMuted}" Margin="0,6,0,6"
                                               Visibility="{Binding Hardware.IsLoading, Converter={StaticResource BoolToVis}}"/>

                                    <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,4,0,8"
                                            Visibility="{Binding Hardware.ErrorMessage, Converter={StaticResource StrVis}}">
                                        <TextBlock Text="{Binding Hardware.ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
                                    </Border>

                                    <ItemsControl x:Name="HardwareChecksList" ItemsSource="{Binding Hardware.Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <DockPanel>
                                                        <Ellipse DockPanel.Dock="Right" Width="9" Height="9" VerticalAlignment="Center" Margin="10,0,4,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:HardwareCheckSeverity.Warning}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Warning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:HardwareCheckSeverity.Fail}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding ValueText}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- UNIFIED FOOTER BAR -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Border x:Name="ProgressSection" Style="{StaticResource Redesign.Card}" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding HasInstallActivity, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressValue, StringFormat={}{0}%}"
                                       Foreground="{DynamicResource OnSurfaceMuted}"/>
                            <TextBlock FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ProgressText}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentStage}" Value="VerifySource"/>
                                                    <Condition Binding="{Binding CurrentStageState}" Value="Running"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{DynamicResource WS_Stage_VerifySource_Running}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentStage}" Value="ApplyWindows"/>
                                                    <Condition Binding="{Binding CurrentStageState}" Value="Running"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{DynamicResource WS_Stage_ApplyWindows_Running}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Redesign.ProgressBar}" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}" Height="6" Margin="0,0,0,8"/>
                        <Grid Visibility="{Binding InstallLogPath, Converter={StaticResource NullVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource WS_Logs}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceMuted}"/>
                            <TextBox Grid.Column="1" Text="{Binding InstallLogPath, Mode=OneWay}" IsReadOnly="True" Height="32"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BdCard}"
                        BorderThickness="1" CornerRadius="10" Padding="14,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="FooterVersionText"
                                       Text="{Binding AppVersionText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceMuted}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="StartButton"
                                    Content="{DynamicResource WS_Start}"
                                    Style="{StaticResource Redesign.PrimaryButton}"
                                    MinHeight="34" Height="34" Padding="18,0"
                                    Margin="14,0,0,0"
                                    Visibility="{Binding IsInstallMainTab, Converter={StaticResource BoolToVis}}"
                                    IsEnabled="{Binding CanStart}"
                                    Click="Review_Click"/>
                            <Button x:Name="StartBackupButton"
                                    Content="{DynamicResource WS_StartBackup}"
                                    Style="{StaticResource Redesign.PrimaryButton}"
                                    MinHeight="34" Height="34" Padding="18,0"
                                    Margin="14,0,0,0"
                                    Visibility="{Binding IsBackupMainTab, Converter={StaticResource BoolToVis}}"
                                    IsEnabled="{Binding Backup.CanStartBackup}"
                                    Click="StartBackup_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="FooterStatusLabel"
                                   Text="{Binding FooterStatusText}"
                                   Foreground="{DynamicResource OnSurfaceSecondary}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </StackPanel>
    </Grid>
</fw:FeatureWindow>
