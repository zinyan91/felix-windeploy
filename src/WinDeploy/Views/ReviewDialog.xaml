<Window x:Class="Felix.WindowSetup.Views.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_Review_Title}"
        Width="680"
        Height="520"
        MinWidth="540"
        MinHeight="400"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Danger}"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" x:Name="DiskConfirmation" Margin="0,12,0,0"
                    Visibility="{Binding RequiresDiskNumber, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{DynamicResource WS_Review_TypeDiskNumber}" Margin="0,0,0,6"/>
            <TextBox x:Name="DiskNumberBox" Text="{Binding TypedDiskNumber, UpdateSourceTrigger=PropertyChanged}"
                     Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource WS_Back}" Style="{StaticResource Redesign.Button}"
                    MinHeight="36" Padding="16,6" Margin="0,0,8,0" Click="Back_Click"/>
            <Button x:Name="ConfirmButton" Content="{DynamicResource WS_Start}" Style="{StaticResource Redesign.PrimaryButton}"
                    MinHeight="36" Padding="18,6" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
