<Window x:Class="Felix.WindowSetup.Views.DriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_Drivers_Title}"
        Width="880"
        Height="560"
        MinWidth="700"
        MinHeight="460"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RecommendedPresetButton" Content="{DynamicResource WS_Drivers_PresetRecommended}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4" Margin="0,0,6,0"
                        Click="RecommendedPreset_Click"/>
                <Button x:Name="MinimumPresetButton" Content="{DynamicResource WS_Drivers_PresetMinimum}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4" Margin="0,0,6,0"
                        Click="MinimumPreset_Click"/>
                <Button x:Name="AllPresetButton" Content="{DynamicResource WS_Drivers_PresetAll}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4" Margin="0,0,6,0"
                        Click="AllPreset_Click"/>
                <Button x:Name="ClearPresetButton" Content="{DynamicResource WS_Drivers_PresetClear}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4" Margin="0,0,14,0"
                        Click="ClearPreset_Click"/>
                <CheckBox x:Name="KeepLatestOnlyCheck" Content="{DynamicResource WS_Drivers_KeepLatest}"
                          IsChecked="{Binding KeepLatestOnly}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="DriverSearchBox" Grid.Column="1" Margin="14,0,0,0" Height="34"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TextBlock x:Name="LoadErrorText" Grid.Row="1" Margin="0,0,0,8"
                   Text="{Binding LoadError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                   Visibility="{Binding LoadError, Converter={StaticResource StrVis}}"/>

        <Border x:Name="CriticalStorageWarningBanner" Grid.Row="2"
                Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerOutline}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding HasMissingCriticalStorageWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{DynamicResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="{DynamicResource WS_Drivers_StorageWarning}"/>
                <Run Text=" "/>
                <Run Text="{Binding MissingCriticalStorageWarning, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <DataGrid x:Name="DriversGrid" Grid.Row="3"
                  RowHeight="36"
                  Padding="4"
                  ItemsSource="{Binding FilteredDrivers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="48" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Width="125" Header="{DynamicResource WS_Drivers_ColPublished}" Binding="{Binding PublishedName}" IsReadOnly="True"/>
                <DataGridTextColumn Width="150" Header="{DynamicResource WS_Drivers_ColInf}" Binding="{Binding InfFileName}" IsReadOnly="True"/>
                <DataGridTextColumn Width="95" Header="{DynamicResource WS_Drivers_ColClass}" Binding="{Binding ClassName}" IsReadOnly="True"/>
                <DataGridTextColumn Width="*" Header="{DynamicResource WS_Drivers_ColProvider}" Binding="{Binding ProviderName}" IsReadOnly="True"/>
                <DataGridTextColumn Width="120" Header="{DynamicResource WS_Drivers_ColVersion}" Binding="{Binding VersionText}" IsReadOnly="True"/>
                <DataGridTextColumn Width="100" Header="{DynamicResource WS_Drivers_ColDate}" Binding="{Binding DateText}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource WS_Cancel}" Style="{StaticResource Redesign.Button}"
                        MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ApplyDriversButton" Content="{DynamicResource WS_Drivers_Apply}"
                        Style="{StaticResource Redesign.PrimaryButton}"
                        MinHeight="34" Padding="14,6" Click="Apply_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedCount}" FontWeight="SemiBold"/>
                <TextBlock Text=" / " Foreground="{DynamicResource OnSurfaceMuted}"/>
                <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                <CheckBox x:Name="DriverDialogBackupPrintersCheck"
                          Content="{DynamicResource WS_Option_BackupPrinters}"
                          IsChecked="{Binding BackupPrinters}"
                          IsEnabled="{Binding IsPrintBrmAvailable}"
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
