<fw:FeatureWindow x:Class="Felix.WindowSetup.Views.ResumeInstallWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:fw="clr-namespace:Felix.UI.Controls;assembly=Felix.UI"
                  xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
                  Title="{DynamicResource WS_Resume_Title}"
                  Width="780"
                  Height="540"
                  MinWidth="660"
                  MinHeight="460"
                  FontSize="13.5"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Redesign.Card}" Padding="16">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="FontDecreaseButton" Content="A-" Style="{StaticResource Redesign.Button}"
                                MinHeight="30" Height="30" Padding="10,0" Margin="0,0,6,0" Click="FontDecrease_Click"/>
                        <Button x:Name="FontIncreaseButton" Content="A+" Style="{StaticResource Redesign.Button}"
                                MinHeight="30" Height="30" Padding="10,0" Click="FontIncrease_Click"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource WS_Resume_Heading}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Resume_Source}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="SourceSummaryText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource WS_Resume_Target}" Foreground="{DynamicResource OnSurfaceMuted}"/>
                    <TextBlock x:Name="TargetSummaryText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Redesign.Card}" Padding="14" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Foreground="{DynamicResource OnSurfaceMuted}" FontWeight="SemiBold" Text="0%"/>
                    <TextBlock x:Name="StageText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Height="10" Style="{StaticResource Redesign.ProgressBar}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Redesign.Card}" Padding="10" Margin="0,10,0,0">
            <TextBox x:Name="LogConsoleBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     FontFamily="Consolas, Cascadia Mono, Segoe UI"
                     FontSize="12.5"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>

        <Border x:Name="ErrorBanner" Grid.Row="3"
                Background="{DynamicResource DangerSoft}"
                BorderBrush="{DynamicResource DangerOutline}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,10,0,0"
                Visibility="{Binding Text, ElementName=ErrorText, Converter={StaticResource StrVis}}">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="SafeStopButton" Content="{DynamicResource WS_Resume_SafeStop}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,0" Margin="0,0,6,0"
                        Click="SafeStop_Click"/>
                <Button x:Name="ContinueButton" Content="{DynamicResource WS_Resume_Continue}"
                        Style="{StaticResource Redesign.PrimaryButton}" MinHeight="34" Padding="12,0" Margin="0,0,6,0"
                        Visibility="Collapsed" Click="Continue_Click"/>
                <Button x:Name="CancelToOldWindowsButton" Content="{DynamicResource WS_Resume_CancelToOldWin}"
                        Style="{StaticResource Redesign.DangerButton}" MinHeight="34" Padding="12,0" Margin="0,0,6,0"
                        Visibility="Collapsed" Click="CancelToOldWindows_Click"/>
                <Button x:Name="RetryButton" Content="{DynamicResource WS_Resume_Retry}"
                        Style="{StaticResource Redesign.PrimaryButton}" MinHeight="34" Padding="12,0"
                        Visibility="Collapsed" Click="Retry_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenCmdButton" Content="{DynamicResource WS_Resume_OpenCmd}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,0" Margin="0,0,6,0"
                        Click="OpenCmd_Click"/>
                <Button x:Name="RestartButton" Content="{DynamicResource WS_Resume_Restart}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,0" Margin="0,0,6,0"
                        Click="Restart_Click"/>
                <Button x:Name="ShutDownButton" Content="{DynamicResource WS_Resume_Shutdown}"
                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,0"
                        Click="ShutDown_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</fw:FeatureWindow>
