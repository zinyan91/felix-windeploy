<Window x:Class="Felix.WindowSetup.Views.BloatwareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_Bloatware_Title}"
        Width="700"
        Height="560"
        MinWidth="580"
        MinHeight="460"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <CheckBox x:Name="EnableBloatwareCheck" Content="{DynamicResource WS_Bloatware_Enable}" Margin="0,0,0,8"/>
            <CheckBox x:Name="BlockPromotedCheck" Content="{DynamicResource WS_Bloatware_BlockPromoted}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource WS_Drivers_PresetRecommended}" Style="{StaticResource Redesign.Button}"
                        MinHeight="32" Padding="12,4" Margin="0,0,6,0" Click="Recommended_Click"/>
                <Button Content="{DynamicResource WS_Drivers_PresetAll}" Style="{StaticResource Redesign.Button}"
                        MinHeight="32" Padding="12,4" Margin="0,0,6,0" Click="SelectAll_Click"/>
                <Button Content="{DynamicResource WS_Drivers_PresetClear}" Style="{StaticResource Redesign.Button}"
                        MinHeight="32" Padding="12,4" Margin="0,0,6,0" Click="Clear_Click"/>
                <Button x:Name="ScanImageButton" Content="{DynamicResource WS_Bloatware_Scan}" Style="{StaticResource Redesign.Button}"
                        MinHeight="32" Padding="12,4" Click="ScanImage_Click"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="32" Margin="12,0,0,0"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <ProgressBar x:Name="ScanProgressBar" Grid.Row="2" IsIndeterminate="True" Height="4"
                     Style="{StaticResource Redesign.ProgressBar}" Visibility="Collapsed" Margin="0,0,0,8"/>

        <Border Grid.Row="3" Style="{StaticResource Redesign.Card}" Padding="10">
            <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PackagePrefix}" Foreground="{DynamicResource OnSurfaceMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource WS_Cancel}" Style="{StaticResource Redesign.Button}"
                        MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ApplyBloatwareButton" Content="{DynamicResource WS_Drivers_Apply}"
                        Style="{StaticResource Redesign.PrimaryButton}" MinHeight="34" Padding="16,6"
                        Click="Apply_Click"/>
            </StackPanel>
            <TextBlock x:Name="SelectedSummaryText" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}"/>
        </DockPanel>
    </Grid>
</Window>
