<Window x:Class="Felix.WindowSetup.Views.RemoteAppsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Felix.WindowSetup.Helpers"
        Title="{DynamicResource WS_RemoteApps_Title}"
        Width="700"
        Height="400"
        MinWidth="580"
        MinHeight="340"
        Background="{DynamicResource BgApp}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ItemsControl x:Name="RemoteAppsList" Grid.Row="0" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BdCard}"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Margin="0,0,8,0"
                                         Visibility="{Binding ShowPasswordEditor, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="2" Content="{DynamicResource WS_Unattend_Generate}"
                                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4"
                                        Margin="0,0,6,0" Tag="{Binding}" Click="GeneratePassword_Click"
                                        Visibility="{Binding ShowPasswordEditor, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="3" Content="{DynamicResource WS_Copy}"
                                        Style="{StaticResource Redesign.Button}" MinHeight="34" Padding="12,4"
                                        Tag="{Binding}" Click="CopyPassword_Click"
                                        Visibility="{Binding ShowPasswordEditor, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                                           Text="{DynamicResource WS_RemoteApps_TeamViewerSession}"
                                           Foreground="{DynamicResource OnSurfaceMuted}" VerticalAlignment="Center"
                                           Visibility="{Binding ShowTeamViewerNote, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Danger}"
                                       Margin="175,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ValidationError, Converter={StaticResource StrVis}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource WS_Cancel}" Style="{StaticResource Redesign.Button}"
                    MinHeight="34" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ApplyRemoteAppsButton" Content="{DynamicResource WS_Drivers_Apply}"
                    Style="{StaticResource Redesign.PrimaryButton}"
                    MinHeight="34" Padding="14,6"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
